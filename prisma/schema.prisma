generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum ResultStatus {
  DRAFT
  PUBLISHED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model School {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  students     Student[]
  classes      Class[]
  subjects     Subject[]
  sessions     AcademicSession[]
  results      Result[]
  auditLogs    AuditLog[]
  invitations  StudentInvitation[]
  gradingScale GradingScale[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student          Student?
  auditLogs        AuditLog[]
  publishedResults PublishedResult[]

  @@index([schoolId])
  @@index([role])
}

model Student {
  id          String   @id @default(cuid())
  admissionNo String
  fullName    String
  classId     String
  schoolId    String
  userId      String?  @unique
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class               @relation(fields: [classId], references: [id])
  results     Result[]
  invitations StudentInvitation[]

  @@unique([schoolId, admissionNo])
  @@index([classId])
  @@index([schoolId])
}

model SchoolMembership {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  level     String?
  schoolId  String
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]
  results  Result[]

  @@unique([schoolId, name])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String?
  schoolId  String
  createdAt DateTime @default(now())

  school School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores ResultSubjectScore[]

  @@unique([schoolId, name])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms  Term[]

  @@unique([schoolId, name])
}

model Term {
  id        String   @id @default(cuid())
  name      String
  sessionId String
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results Result[]

  @@unique([sessionId, name])
}

model Result {
  id                String       @id @default(cuid())
  studentId         String
  classId           String
  termId            String
  schoolId          String
  status            ResultStatus @default(DRAFT)
  totalScore        Float?
  average           Float?
  teacherRemark     String?
  principalRemark   String?
  attendancePresent Int?
  attendanceTotal   Int?
  createdById       String
  publishedById     String?
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       Class                @relation(fields: [classId], references: [id])
  term        Term                 @relation(fields: [termId], references: [id])
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores      ResultSubjectScore[]
  published   PublishedResult?
  corrections ResultCorrection[]

  @@unique([studentId, termId])
  @@index([status])
  @@index([classId])
  @@index([schoolId])
}

model ResultSubjectScore {
  id                   String  @id @default(cuid())
  resultId             String
  subjectId            String
  firstCA              Float   @default(0)
  secondCA             Float   @default(0)
  thirdCA              Float   @default(0)
  exam                 Float   @default(0)
  total                Float
  grade                String
  subjectTeacherRemark String?

  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
}

model PublishedResult {
  id            String   @id @default(cuid())
  resultId      String   @unique
  publishedById String
  publishedAt   DateTime @default(now())
  snapshot      Json

  result    Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  publisher User   @relation(fields: [publishedById], references: [id])
}

model ResultCorrection {
  id            String   @id @default(cuid())
  resultId      String
  changedById   String
  previousValue Json
  newValue      Json
  reason        String?
  createdAt     DateTime @default(now())

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  schoolId   String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([action])
}

model StudentInvitation {
  id        String           @id @default(cuid())
  studentId String
  schoolId  String
  tokenHash String           @unique
  email     String?
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model GradingScale {
  id       String  @id @default(cuid())
  schoolId String
  minScore Int
  maxScore Int
  grade    String
  remark   String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, grade])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}